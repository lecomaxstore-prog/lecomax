"use client";
import { useEffect, useState } from "react";
import { usePathname } from "next/navigation";
import Link from "next/link";

type Ad = {
  id: string;
  type: "popup" | "topbar" | "corner" | "floating";
  heading: string | null;
  body: string | null;
  image_url: string | null;
  button_label: string | null;
  button_href: string | null;
  bg_color: string;
  text_color: string;
  accent_color: string;
  delay_seconds: number;
  frequency: "always" | "once_session" | "once_day" | "once_total";
  target_pages: string;
};

const STORAGE_KEY = "lecomax_ads_seen";

function getSeen(): Record<string, number> {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}"); }
  catch { return {}; }
}

function markSeen(id: string) {
  const seen = getSeen();
  seen[id] = Date.now();
  localStorage.setItem(STORAGE_KEY, JSON.stringify(seen));
}

function shouldShow(ad: Ad): boolean {
  const seen = getSeen();
  const lastSeen = seen[ad.id];
  if (!lastSeen) return true;
  if (ad.frequency === "always") return true;
  if (ad.frequency === "once_total") return false;
  if (ad.frequency === "once_day") return Date.now() - lastSeen > 86_400_000;
  // once_session: check sessionStorage
  try {
    const sessKey = `lecomax_ad_sess_${ad.id}`;
    if (sessionStorage.getItem(sessKey)) return false;
  } catch { /* noop */ }
  return true;
}

function markSession(id: string) {
  try { sessionStorage.setItem(`lecomax_ad_sess_${id}`, "1"); } catch { /* noop */ }
}

function matchesPage(target: string, pathname: string): boolean {
  if (target === "all") return true;
  if (target === "home") return pathname === "/";
  if (target === "boutique") return pathname.startsWith("/boutique");
  if (target === "product") return pathname.startsWith("/produit");
  if (target === "cart") return pathname.startsWith("/panier");
  // custom path list
  try {
    const paths: string[] = JSON.parse(target);
    return paths.some((p) => pathname.startsWith(p));
  } catch { return false; }
}

export default function AdsDisplay() {
  const pathname = usePathname();
  const [ads, setAds] = useState<Ad[]>([]);
  const [visible, setVisible] = useState<Record<string, boolean>>({});

  const isAdmin = pathname?.startsWith("/admin") ?? false;

  // All hooks must run unconditionally — check isAdmin inside each effect
  useEffect(() => {
    if (isAdmin) return;
    fetch("/api/ads")
      .then((r) => r.json())
      .then((data: Ad[]) => {
        if (!Array.isArray(data)) return;
        setAds(data.filter((a) => matchesPage(a.target_pages, pathname ?? "/")));
      })
      .catch(() => {});
  }, [pathname, isAdmin]);

  useEffect(() => {
    const timers: ReturnType<typeof setTimeout>[] = [];
    ads.forEach((ad) => {
      if (!shouldShow(ad)) return;
      const delay = (ad.type === "topbar" ? 0 : (ad.delay_seconds || 0)) * 1000;
      const t = setTimeout(() => {
        setVisible((v) => ({ ...v, [ad.id]: true }));
        if (ad.frequency === "once_session") markSession(ad.id);
        if (ad.frequency !== "always") markSeen(ad.id);
      }, delay);
      timers.push(t);
    });
    return () => timers.forEach(clearTimeout);
  }, [ads]);

  function dismiss(id: string) {
    setVisible((v) => ({ ...v, [id]: false }));
  }

  // Guard after all hooks
  if (isAdmin) return null;

  const visibleAds = ads.filter((a) => visible[a.id]);
  if (visibleAds.length === 0) return null;

  const topbars = visibleAds.filter((a) => a.type === "topbar");
  const popups = visibleAds.filter((a) => a.type === "popup");
  const corners = visibleAds.filter((a) => a.type === "corner");
  const floaters = visibleAds.filter((a) => a.type === "floating");

  return (
    <>
      {/* ── Topbar ads ── */}
      {topbars.map((ad) => (
        <div key={ad.id} className="relative z-[9999] px-4 py-2.5 flex items-center justify-between gap-3 text-sm font-semibold"
          style={{ background: ad.bg_color, color: ad.text_color }}>
          <div className="flex-1 flex items-center justify-center gap-3 flex-wrap">
            {ad.heading && <span className="font-bold">{ad.heading}</span>}
            {ad.body && <span className="opacity-70 text-xs">{ad.body}</span>}
            {ad.button_label && ad.button_href && (
              <Link href={ad.button_href} className="text-xs font-black px-3 py-1 rounded-full transition-opacity hover:opacity-80"
                style={{ background: ad.accent_color, color: "#000" }}>
                {ad.button_label}
              </Link>
            )}
          </div>
          <button onClick={() => dismiss(ad.id)} className="flex-shrink-0 opacity-50 hover:opacity-100 transition-opacity p-1"
            aria-label="Fermer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      ))}

      {/* ── Popup modal ── */}
      {popups.map((ad) => (
        <div key={ad.id} className="fixed inset-0 z-[9998] flex items-center justify-center p-4"
          style={{ background: "rgba(0,0,0,0.6)", backdropFilter: "blur(4px)" }}
          onClick={(e) => { if (e.target === e.currentTarget) dismiss(ad.id); }}>
          <div className="relative w-full max-w-md rounded-2xl overflow-hidden shadow-2xl animate-in zoom-in-95 duration-200"
            style={{ background: ad.bg_color, color: ad.text_color }}>
            <button onClick={() => dismiss(ad.id)}
              className="absolute top-3 right-3 z-10 w-8 h-8 rounded-full flex items-center justify-center transition-opacity hover:opacity-80"
              style={{ background: ad.text_color + "22" }} aria-label="Fermer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ad.text_color} strokeWidth="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
            {ad.image_url && (
              <img src={ad.image_url} alt={ad.heading ?? ""} className="w-full h-52 object-cover" />
            )}
            <div className="p-6">
              {ad.heading && <h2 className="font-black text-2xl mb-2 leading-tight">{ad.heading}</h2>}
              {ad.body && <p className="text-sm opacity-70 mb-5 leading-relaxed">{ad.body}</p>}
              {ad.button_label && ad.button_href && (
                <Link href={ad.button_href} onClick={() => dismiss(ad.id)}
                  className="inline-flex items-center gap-2 text-sm font-black px-6 py-3 rounded-xl transition-opacity hover:opacity-90"
                  style={{ background: ad.accent_color, color: "#000" }}>
                  {ad.button_label}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </Link>
              )}
            </div>
          </div>
        </div>
      ))}

      {/* ── Corner notifications (bottom-right stack) ── */}
      {corners.length > 0 && (
        <div className="fixed bottom-6 right-6 z-[9997] flex flex-col gap-3 items-end" style={{ maxWidth: "320px" }}>
          {corners.map((ad) => (
            <div key={ad.id} className="w-full rounded-2xl shadow-2xl overflow-hidden animate-in slide-in-from-right-5 duration-300"
              style={{ background: ad.bg_color, color: ad.text_color }}>
              {ad.image_url && <img src={ad.image_url} alt="" className="w-full h-32 object-cover" />}
              <div className="p-4 relative">
                <button onClick={() => dismiss(ad.id)}
                  className="absolute top-3 right-3 opacity-40 hover:opacity-80 transition-opacity" aria-label="Fermer">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke={ad.text_color} strokeWidth="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
                {ad.heading && <p className="font-black text-sm mb-1 pr-5">{ad.heading}</p>}
                {ad.body && <p className="text-xs opacity-60 mb-3">{ad.body}</p>}
                {ad.button_label && ad.button_href && (
                  <Link href={ad.button_href} onClick={() => dismiss(ad.id)}
                    className="inline-block text-xs font-black px-4 py-2 rounded-lg transition-opacity hover:opacity-80"
                    style={{ background: ad.accent_color, color: "#000" }}>
                    {ad.button_label}
                  </Link>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      {/* ── Floating bottom banner ── */}
      {floaters.map((ad) => (
        <div key={ad.id} className="fixed bottom-0 left-0 right-0 z-[9996] shadow-2xl animate-in slide-in-from-bottom-4 duration-300"
          style={{ background: ad.bg_color, color: ad.text_color }}>
          <div className="max-w-5xl mx-auto px-4 py-3 flex items-center gap-4">
            {ad.image_url && <img src={ad.image_url} alt="" className="w-12 h-12 object-cover rounded-xl flex-shrink-0" />}
            <div className="flex-1 min-w-0">
              {ad.heading && <p className="font-black text-sm">{ad.heading}</p>}
              {ad.body && <p className="text-xs opacity-60">{ad.body}</p>}
            </div>
            {ad.button_label && ad.button_href && (
              <Link href={ad.button_href} onClick={() => dismiss(ad.id)}
                className="flex-shrink-0 text-xs font-black px-5 py-2.5 rounded-xl transition-opacity hover:opacity-80"
                style={{ background: ad.accent_color, color: "#000" }}>
                {ad.button_label}
              </Link>
            )}
            <button onClick={() => dismiss(ad.id)}
              className="flex-shrink-0 p-2 opacity-40 hover:opacity-80 transition-opacity" aria-label="Fermer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={ad.text_color} strokeWidth="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        </div>
      ))}
    </>
  );
}
