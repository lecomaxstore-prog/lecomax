CREATE TABLE public.products (
 id text PRIMARY KEY CHECK (id LIKE 'seo-fixture-%'), name text NOT NULL,
 slug text NOT NULL UNIQUE CHECK (slug LIKE 'seo-fixture-%'), active boolean NOT NULL DEFAULT false,
 description text, category text, brand text, images jsonb NOT NULL DEFAULT '[]'::jsonb CHECK (jsonb_typeof(images)='array'),
 stock integer NOT NULL DEFAULT 0 CHECK (stock >= 0)
);
CREATE TABLE public.categories (
 id integer PRIMARY KEY CHECK (id IN (910001,910002)), name text NOT NULL,
 slug text NOT NULL UNIQUE CHECK (slug LIKE 'seo-fixture-%'), active boolean NOT NULL DEFAULT false, description text, image text
);
CREATE TABLE public.admin_roles (id uuid PRIMARY KEY, name text NOT NULL UNIQUE CHECK (name IN ('seo-fixture-editor','seo-fixture-viewer')));
CREATE TABLE public.admin_staff (
 id uuid PRIMARY KEY, email text NOT NULL UNIQUE CHECK (email IN ('editor@staging.invalid','viewer@staging.invalid','revoked@staging.invalid')),
 role_id uuid NOT NULL REFERENCES public.admin_roles(id), status text NOT NULL CHECK (status IN ('active','inactive'))
);
CREATE TABLE public.admin_role_permissions (
 role_id uuid NOT NULL REFERENCES public.admin_roles(id), permission_slug text NOT NULL CHECK (permission_slug IN ('products.view','products.edit')),
 PRIMARY KEY (role_id,permission_slug)
);
