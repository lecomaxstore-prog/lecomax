# Server-only worker settings. No paid calls until separately approved.
SEO_AI_ENABLED=false
SEO_EDITORIAL_ENABLED=false
OPENAI_API_KEY=
# Admin selects legacy Luna/Sol or editorial Luna/Sol/Astra per job.
# Each paid job requires separate owner authorization. New SQL caps monthly
# spending at $5 and cumulative SEO commitments at $50; defaults remain off/$0.
# Reconcile other project spend separately before enabling any worker.
SEO_MIRAI_FALLBACK_ENABLED=false
# Historical provider settings retained; the editorial policy disables Mirai.
SEO_MIRAI_MAX_REQUEST_USD=0
SEO_AI_BASE_URL=
SEO_AI_API_KEY=
SEO_AI_MODEL=
# Keep existing independent worker and runtime activation requirements.
SEO_SYNC_ENABLED=false
