# Required explicit target. Development uses only local Supabase.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# local:sha256(exact key). Hosted bindings require independent project review.
NEXT_PUBLIC_SUPABASE_KEY_BINDING=
SUPABASE_SERVICE_KEY_BINDING=
# Independent random admin signing secret, at least 32 characters.
ADMIN_SESSION_SECRET=
OWNER_DATABASE_BINDING=
SEO_SYNC_ENABLED=false
SEO_AI_ENABLED=false
SEO_EDITORIAL_ENABLED=false
SEO_MANUAL_SYNC_ENABLED=false
SEO_MIRAI_FALLBACK_ENABLED=false
INDEXNOW_ENABLED=false
# Production only: explicitly approved public verification key; no fallback.
INDEXNOW_KEY=
# Private owner learning-section access code (at least 4 characters).
# Configure on the server only; never use a NEXT_PUBLIC_ prefix.
HOW_BUILT_PIN=

NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# Keep disabled until all credentials are configured and the secret is private.
PAYPAL_ENABLED=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
# Server only: shared by website customer chat, Expo assistant and private tutor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# Dedicated mobile programming teacher; independent of customer support.
OPENAI_TEACHER_MODEL=gpt-6-astra
# Optional dedicated model for persisted product description translations.
OPENAI_TRANSLATION_MODEL=
# Optional existing customer-assistance fallback during OpenAI outages/quota errors.
GROQ_API_KEY=
# Long random value also configured in the deployment environment.
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@lecomax.com
EXPO_ACCESS_TOKEN=

# Meta WhatsApp Cloud API. The two templates must be approved in Meta and
# accept two body variables in this order: customer first name, order number.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PRODUCT_REVIEW_TEMPLATE=lecomax_product_review
WHATSAPP_REVIEW_FOLLOWUP_TEMPLATE=lecomax_review_followup
WHATSAPP_TEMPLATE_LANGUAGE=fr
# Bing Webmaster Tools verification token (the value of the msvalidate.01 meta tag).
BING_SITE_VERIFICATION=

# Private L’ECOMAX Learn backend only. Run npm run owner:setup to create real values.
OWNER_EMAIL="contact@lecomax.com"
# Next.js .env.local requires escaped dollar signs; the setup script handles this.
OWNER_PASSWORD_HASH=
SESSION_SECRET="replace-with-64-random-hex-characters"
OWNER_DATABASE_URL=
# Set only behind a proxy which overwrites x-forwarded-for and x-forwarded-proto.
OWNER_TRUST_PROXY="0"

# AI teaching workspace: server-only settings; never EXPO_PUBLIC_*.
# Optional task-specific models fall back to OPENAI_TEACHER_MODEL.
OPENAI_TUTOR_FAST_MODEL=
OPENAI_TUTOR_REASONING_MODEL=
OPENAI_TUTOR_VISION_MODEL=
# Conservative per-owner reservations per UTC day, including a possible retry.
TUTOR_DAILY_TOKEN_BUDGET=200000
# Optional billing estimates only. Set to the configured model's actual rates.
# Leave blank when task-specific models have different prices.
TUTOR_INPUT_USD_PER_MILLION=
TUTOR_OUTPUT_USD_PER_MILLION=
