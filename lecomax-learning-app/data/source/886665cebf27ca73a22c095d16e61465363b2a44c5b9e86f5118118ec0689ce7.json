{"content":"export default function Testimonials() {\n  return (\n    <section aria-labelledby=\"customer-experience-title\" className=\"border-t border-[#e8ece4] bg-[#f8f9f5] px-4 py-12 sm:px-6 sm:py-16\">\n      <div className=\"mx-auto max-w-7xl overflow-hidden rounded-[24px] border border-[#e0e6da] bg-white px-6 py-7 shadow-[0_4px_24px_rgba(24,60,48,0.025)] sm:p-10\">\n        <div className=\"flex flex-col gap-7 md:flex-row md:items-center md:justify-between md:gap-12\">\n          <div className=\"max-w-lg\">\n            <p className=\"mb-4 flex items-center gap-2.5 text-[9px] font-semibold uppercase tracking-[0.22em] text-[#6d836d]\">\n              <span aria-hidden=\"true\" className=\"h-px w-6 bg-[#9aaf91]\" />\n              Votre avis compte\n            </p>\n            <h2 id=\"customer-experience-title\" className=\"text-[30px] font-medium leading-[1.13] tracking-[-0.04em] text-[#183c30] sm:text-[38px]\">\n              Votre exp&eacute;rience,<br />en toute transparence.\n            </h2>\n            <p className=\"mt-4 max-w-sm text-[13px] leading-6 text-[#737d70]\">\n              Consultez les avis sur Trustpilot ou partagez votre exp&eacute;rience avec L&apos;ecomax.\n            </p>\n          </div>\n          <div className=\"flex w-full flex-col gap-4 border-t border-[#edf0e8] pt-6 md:max-w-[260px] md:border-l md:border-t-0 md:pl-8 md:pt-0\">\n            <p className=\"text-sm font-semibold tracking-tight text-[#183c30]\">Retrouvez-nous sur Trustpilot</p>\n            <a\n              href=\"https://www.trustpilot.com/review/lecomax.com\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              aria-label=\"Lire les avis sur Trustpilot (nouvel onglet)\"\n              className=\"group flex min-h-12 items-center justify-between gap-4 rounded-full bg-[#183c30] py-3 pl-5 pr-4 text-xs font-medium text-white transition-colors hover:bg-[#285442] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#183c30] focus-visible:ring-offset-4\"\n            >\n              Lire les avis\n              <svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none\"><path d=\"M7 17 17 7M7 7h10v10\" /></svg>\n            </a>\n            <a href=\"https://www.trustpilot.com/evaluate/lecomax.com\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Partager mon avis sur Trustpilot (nouvel onglet)\" className=\"inline-flex min-h-11 items-center justify-center rounded-full text-xs font-medium text-[#63765f] underline decoration-[#c9d4c2] underline-offset-4 transition-colors hover:text-[#183c30] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#183c30] focus-visible:ring-offset-2\">\n              Partager mon avis\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"}