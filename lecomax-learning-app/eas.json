{
  "cli": {
    "version": ">=18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,x86_64"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "release": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_LEARNING_API_URL": "https://lecomax.com",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,x86_64"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
